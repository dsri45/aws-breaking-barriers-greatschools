<li class="flex items-start gap-2 text-[13px] leading-snug">
  <span class="mt-px shrink-0" title="<%= status_text %>">
    <% case status %>
    <% when "confirmed" %>
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#1E7F4E"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>
    <% when "partial" %>
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#fff" stroke="#B26A00" stroke-width="2"/><path d="M12 2a10 10 0 0 1 0 20z" fill="#B26A00"/></svg>
    <% when "needs_attention" %>
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L23 21H1z" fill="#C2410C"/><path d="M12 9v5M12 17v.5" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
    <% else %>
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="#8A94A3" stroke-width="2" stroke-dasharray="3 3"/><path d="M8 12h8" stroke="#8A94A3" stroke-width="2.4" stroke-linecap="round"/></svg>
    <% end %>
  </span>
  <span>
    <span class="sr-only"><%= status_text %>:</span>
    <strong class="font-semibold"><%= @evidence.label %>:</strong>
    <span class="text-ink-2"><%= @evidence.evidence %></span>
    <% if stale? %>
      <span class="ml-1 rounded bg-amber-100 px-1.5 py-px text-[11px] font-semibold text-warn">From <%= @evidence.as_of.year %></span>
    <% end %>
  </span>
</li>
