# Search & data layer configuration. Copy to .env for local development.
# (The app also reads these from the environment directly in production.)

# --- OpenSearch ---
# Managed Amazon OpenSearch Service (production): set to the HTTPS domain
# endpoint; requests are signed with SigV4 (service "es").
#   OPENSEARCH_URL=https://search-xxxx.us-east-1.es.amazonaws.com
#
# Local development: point at a plain-HTTP Docker node and signing is skipped.
OPENSEARCH_URL=http://localhost:9200
AWS_REGION=us-east-1

# --- Embeddings (Titan Text Embeddings V2) ---
# bedrock -> real Titan via Bedrock invoke_model (needs AWS creds + model access)
# stub    -> deterministic local pseudo-vectors (no AWS; dev/tests/loading)
EMBEDDINGS_MODE=stub
EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDINGS_DIMENSIONS=1024

# --- Guided search wiring ---
# Swap the demo retriever for the real OpenSearch-backed one:
# GUIDED_SEARCH_RETRIEVER=GuidedSearch::OpenSearchRetriever
