<div class="rounded-xl border-[1.5px] border-blue bg-[#F5F9FD] p-4">
  <p class="mb-1 text-[15px] font-semibold leading-snug"><%= @text %></p>
  <% if @hint %><p class="mb-3 text-[13px] text-muted"><%= @hint %></p><% end %>
  <div class="flex flex-wrap gap-2">
    <% @options.each do |option| %>
      <span class="<%= option_classes(option) %>"><%= option %><%= " ✓" if option == @selected %></span>
    <% end %>
  </div>
</div>
