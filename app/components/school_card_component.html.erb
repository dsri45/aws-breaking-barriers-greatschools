<article class="gs-school-card" id="school_<%= @school.school_id.tr(" ", "_") %>"
         data-school-id="<%= @school.school_id %>" data-school-comparison-target="card"
         <%= tag.attributes(tabindex: 0, aria: { label: "Select #{@school.name} for comparison", describedby: "comparison-status" }) if @allow_comparison %>>
  <% profile_path = helpers.school_profile_path(@school.school_id, view: ("shortlist" if @show_shortlist)) %>
  <div class="gs-card-heading">
    <div>
      <h2><%= link_to @school.name, profile_path %></h2>
      <% if profile.address.present? %><p class="gs-card-address"><%= profile.address %></p><% end %>
    </div>
    <% if @school.rated? %>
      <div class="gs-card-rating" aria-label="Rated <%= @school.summary_rating %> out of 10"><span><%= @school.summary_rating %></span><small>/10</small></div>
    <% else %>
      <div class="gs-card-unrated">No rating yet</div>
    <% end %>
  </div>

  <% if @school.avg_review_rating || @school.review_count %>
    <div class="gs-card-reviews">
      <% if @school.avg_review_rating %><span aria-hidden="true" class="gs-review-star">★</span><span><%= @school.avg_review_rating %> /5</span><% end %>
      <% if @school.review_count %><%= link_to "(#{pluralize(@school.review_count, 'Review')})", "#{profile_path}#reviews" %><% end %>
    </div>
  <% end %>

  <ul class="gs-card-badges" aria-label="School facts">
    <% grade_labels.each do |label| %><li><%= label %></li><% end %>
    <% if @school.entity_type.present? %><li><%= ENTITY_LABELS.fetch(@school.entity_type, @school.entity_type.titleize) %></li><% end %>
  </ul>

  <% if rating_factors.any? %>
    <dl class="gs-card-factors">
      <% rating_factors.each do |label, rating| %>
        <div><dt><%= label %></dt><dd><span><%= rating %></span><small>/10</small></dd></div>
      <% end %>
    </dl>
  <% end %>

  <% if @school.why.present? %>
    <p class="gs-card-highlight">
      <svg width="34" height="34" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 23h7l5-5h7c3 0 3 4 0 4h-6m-5 1 5 4h6l8-8M3 21v9h7v-9zm14-7V5m0 4c-6 0-7-5-7-7 5 0 7 2 7 7zm0 5c0-6 4-8 9-8 0 5-3 8-9 8z"/></svg>
      <%= @school.why %>
    </p>
  <% end %>

  <% if @school.criteria.any? %>
    <details class="gs-card-evidence">
      <summary>Your priority matches</summary>
      <ul><% @school.criteria.each do |evidence| %><%= render CriterionRowComponent.new(evidence:) %><% end %></ul>
      <p><%= data_date %> · <%= link_to "Evidence details", "#{profile_path}#evidence" %></p>
    </details>
  <% end %>

  <div class="gs-card-actions">
    <% saved = @allow_saving && @school.saved %>
    <% action = saved ? helpers.api_shortlist_path(@school.school_id, format: :html) : helpers.api_shortlist_index_path(format: :html) %>
    <%= button_to action, method: saved ? :delete : :post,
          params: { school_id: @school.school_id, view: ("shortlist" if @show_shortlist) }.compact,
          disabled: !@allow_saving, aria: { label: saved ? "Remove from my list" : "Save to my list", pressed: saved },
          class: "gs-card-save" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="<%= saved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.4 5 7 5c2 0 3.4 1 5 2.8C13.6 6 15 5 17 5c3.6 0 5.8 3.6 4.5 6.8C19.5 16.4 12 21 12 21z"/></svg>
      <%= saved ? "Saved" : "Save" %>
    <% end %>
    <%= link_to profile_path, class: "gs-card-profile" do %>View full profile <span aria-hidden="true">›</span><% end %>
    <% if @allow_comparison %>
      <label class="gs-card-compare"><%= check_box_tag "ids[]", @school.school_id, false, id: nil, form: "compare-schools",
            data: { school_comparison_target: "checkbox" }, aria: { label: "Compare #{@school.name}" } %>Compare</label>
    <% end %>
  </div>
  <% if @allow_saving %>
    <div class="gs-card-guide-actions" aria-label="Ask about <%= @school.name %>">
      <%= helpers.render "home/guide_action", label: "Why this school?", message: "Why was #{@school.name} chosen for my priorities?", intent: "explain_school", school_id: @school.school_id, view: ("shortlist" if @show_shortlist) %>
      <%= helpers.render "home/guide_action", label: "Plan a school visit", message: "What should I ask on a visit to #{@school.name}?", intent: "visit_questions", school_id: @school.school_id, view: ("shortlist" if @show_shortlist) %>
    </div>
  <% end %>
</article>
