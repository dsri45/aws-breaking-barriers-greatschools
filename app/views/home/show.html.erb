<% content_for :title, "Guided Search" %>

<div class="flex h-screen min-w-[1200px] flex-col overflow-hidden">
  <%# ── Header ─────────────────────────────────────────────── %>
  <header class="flex h-16 shrink-0 items-center gap-8 border-b border-line bg-white px-7">
    <div class="flex items-baseline gap-2">
      <h1 class="text-[22px] font-bold tracking-tight text-navy"><span class="sr-only">GreatSchools </span>Guided Search</h1>
      <span class="rounded-full bg-blue-soft px-2 py-0.5 text-xs font-semibold text-blue">concept</span>
    </div>
    <%= form_with url: root_path, method: :get, class: "flex h-[42px] max-w-[560px] flex-1 items-center gap-2.5 rounded-[10px] border border-line-2 bg-white pl-4 pr-1.5" do |f| %>
      <%= f.label :q, "Search", class: "sr-only" %>
      <%= f.text_field :q, value: @search.query, placeholder: "Tell us what you're looking for",
            class: "flex-1 border-0 bg-transparent p-0 text-[15px] focus:ring-0 focus:outline-none" %>
      <button type="submit" aria-label="Search" class="flex size-[34px] items-center justify-center rounded-lg bg-navy">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      </button>
    <% end %>
    <nav class="ml-auto flex items-center gap-7 text-[15px] font-medium">
      <a href="#" class="hover:text-navy">Parenting</a>
      <a href="#" class="hover:text-navy">Schools by district</a>
      <a href="#" class="flex items-center gap-1.5 hover:text-navy">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#D64545" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.4 5 7 5c2 0 3.4 1 5 2.8C13.6 6 15 5 17 5c3.6 0 5.8 3.6 4.5 6.8C19.5 16.4 12 21 12 21z"/></svg>
        My list (<%= @search.schools.count(&:saved) %>)
      </a>
    </nav>
  </header>

  <%# ── Criteria chips (filled by the agent, editable) ──────── %>
  <div class="flex shrink-0 items-center gap-2.5 overflow-x-auto border-b border-line bg-white px-7 py-3">
    <span class="mr-1 shrink-0 whitespace-nowrap text-[13px] font-semibold text-muted">Your priorities</span>
    <% @search.criteria.each do |c| %>
      <% required = c.importance == "require" %>
      <button type="button" class="flex h-[34px] shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-3.5 text-sm font-medium <%= required ? "border-[1.5px] border-blue bg-blue-soft text-navy" : "border-[1.5px] border-line-2 bg-white text-ink-2" %>">
        <% unless c.key.in?(%w[level location]) %>
          <span class="rounded-md px-1.5 py-px text-[11px] font-bold <%= required ? "bg-navy text-white" : "bg-[#EEF1F4] text-ink-2" %>"><%= required ? "MUST" : "NICE" %></span>
        <% end %>
        <%= c.label %>
      </button>
    <% end %>
    <button type="button" class="h-[34px] shrink-0 whitespace-nowrap rounded-full border-[1.5px] border-dashed border-line-2 bg-white px-3.5 text-sm font-medium text-muted">+ Add priority</button>
    <span class="ml-auto shrink-0 whitespace-nowrap text-[13px] text-muted">Filled in from your question · tap to edit</span>
  </div>

  <div class="flex min-h-0 flex-1">
    <%# ── Left: chat ─────────────────────────────────────────── %>
    <aside class="flex w-[360px] shrink-0 flex-col border-r border-line bg-white">
      <div class="flex items-center gap-2.5 border-b border-[#EEF1F4] px-5 py-3.5">
        <span class="text-base font-semibold">School guide</span>
        <button type="button" class="ml-auto h-[30px] rounded-lg border border-line bg-[#F7F8FA] px-2.5 text-[13px] text-ink-2">Your child: Grade 6 ▾</button>
      </div>

      <div id="messages" class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto p-5">
        <% @search.messages.each do |m| %>
          <% case m["role"] %>
          <% when "user" %>
            <div class="max-w-[290px] self-end rounded-2xl rounded-br-sm bg-[#EEF1F4] px-4 py-3 text-[15px] leading-snug"><%= m["text"] %></div>
          <% when "assistant" %>
            <p class="text-[15px] leading-relaxed"><%= highlight_phrases(m["text"], m["highlights"]) %></p>
          <% when "question" %>
            <%= render QuestionCardComponent.new(text: m["text"], options: m["options"], hint: m["hint"], selected: m["selected"]) %>
          <% when "status" %>
            <ul class="flex flex-col gap-2 rounded-[10px] bg-[#F7F8FA] px-3.5 py-3 text-[13px] text-ink-2">
              <% m["steps"].each do |step| %>
                <li class="flex items-center gap-2">
                  <% if step["state"] == "done" %>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1E7F4E" stroke-width="3" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>
                  <% else %>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B26A00" stroke-width="2.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16.5v.5"/></svg>
                  <% end %>
                  <%= step["text"] %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% end %>
      </div>

      <div class="border-t border-[#EEF1F4] px-5 pb-[18px] pt-3.5">
        <%= form_with url: root_path, method: :get, class: "flex h-12 items-center gap-2.5 rounded-full border-[1.5px] border-navy pl-4 pr-1.5" do |f| %>
          <%= f.label :follow_up, "Ask a follow-up", class: "sr-only" %>
          <%= f.text_field :follow_up, placeholder: "Ask a follow-up, e.g. compare Oak Ridge and Pine Hill",
                class: "flex-1 border-0 bg-transparent p-0 text-sm focus:ring-0 focus:outline-none" %>
          <button type="submit" aria-label="Send" class="flex size-9 items-center justify-center rounded-full bg-navy">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
          </button>
        <% end %>
      </div>
    </aside>

    <%# ── Middle: ranked school cards ────────────────────────── %>
    <main class="flex min-w-0 flex-1 flex-col">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-6 pb-3 pt-[18px]">
        <h2 class="text-xl font-bold"><%= pluralize(@search.schools.size, "school") %> match near Woodstock, GA</h2>
        <label class="ml-auto flex items-center gap-2.5 whitespace-nowrap text-sm font-medium">Compare <input type="checkbox" class="size-4"></label>
        <button type="button" class="h-9 whitespace-nowrap rounded-lg border border-line-2 bg-white px-3.5 text-[13px] font-medium">Refresh unsaved results</button>
      </div>

      <div id="results" class="flex min-h-0 flex-1 flex-col gap-3.5 overflow-y-auto px-6 pb-6 pt-1">
        <% @search.schools.each_with_index do |school, i| %>
          <%= render SchoolCardComponent.new(school:, selected: i.zero?) %>
        <% end %>

        <div class="flex items-center gap-3 px-1 py-2.5 text-sm text-ink-2">
          Did we understand your priorities?
          <button type="button" aria-label="Yes" class="flex size-[34px] items-center justify-center rounded-full border border-line-2 bg-white"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3D4756" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v11H3V10zM7 10l4-8c1.7 0 2.8 1.2 2.5 3L13 9h6.5c1.3 0 2.2 1.2 1.9 2.4l-2 8c-.2.9-1 1.6-1.9 1.6H7"/></svg></button>
          <button type="button" aria-label="No" class="flex size-[34px] items-center justify-center rounded-full border border-line-2 bg-white"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3D4756" stroke-width="2" stroke-linejoin="round" aria-hidden="true" style="transform: rotate(180deg)"><path d="M7 10v11H3V10zM7 10l4-8c1.7 0 2.8 1.2 2.5 3L13 9h6.5c1.3 0 2.2 1.2 1.9 2.4l-2 8c-.2.9-1 1.6-1.9 1.6H7"/></svg></button>
        </div>
      </div>
    </main>

    <%# ── Right: map ─────────────────────────────────────────── %>
    <%= render MapPaneComponent.new(pins: @search.pins) %>
  </div>
</div>
